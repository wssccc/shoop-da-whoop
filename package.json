{
  "name": "shoop-da-whoop",
  "type": "module",
  "description": "Shoop Da Whoop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "typecheck": "vue-tsc --noEmit -p games/othello/tsconfig.app.json && vue-tsc --noEmit -p games/solitaire/tsconfig.app.json && vue-tsc --noEmit -p games/burnrate/tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "bench:burnrate": "BENCH=1 vitest run games/burnrate/src/game/bench.test.ts",
    "bench:burnrate:mass": "BENCH_MASS=1 vitest run games/burnrate/src/game/bench-mass.test.ts",
    "legacy-check": "vite build && ls -la dist/assets"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-vue-next": "^0.468.0",
    "motion-v": "^2.3.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.160.1",
    "vue": "^3.5.13",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-legacy": "^8.2.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.39.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.23",
    "postcss-preset-env": "^11.3.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.49.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.10"
  }
}
